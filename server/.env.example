# Copy this file to .env and replace every placeholder before hosting.
SHINY=
YOUTUBER=
BETA_TESTER=
DEVELOPER=replace-with-a-private-developer-token
API_KEY=replace-with-a-private-api-key
ADMIN=replace-with-a-private-admin-token
CREATIVE=replace-with-a-private-creative-token
ADMIN_PASSWORD_CODES=code-1,code-2,code-3

# Development only. Keep false on public servers.
ALLOW_UNSAFE_ADMIN_COMMANDS=false
HOSTED_MODE=false
